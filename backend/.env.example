# SmartCommute Backend Environment Variables
PORT=5000
NODE_ENV=development

# Optional: Firebase Service Account credentials for Live Realtime Database
# If left blank, SmartCommute automatically activates the high-fidelity Kota In-Memory Demo Database.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

